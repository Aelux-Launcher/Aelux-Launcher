{
  "name": "aelux-launcher-app",
  "version": "0.1.0",
  "description": "Aelux Launcher 桌面启动器壳（Tauri 2 + React + Zustand），消费 aelux-components 与 aelux-launcher-lib。",
  "author": "Aelux",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:web": "vite",
    "dev:desktop": "tauri dev",
    "build": "npm run build:desktop",
    "build:web": "vite build",
    "build:desktop": "tauri build",
    "build:win": "tauri build --bundles nsis,msi",
    "build:mac": "tauri build --bundles dmg,app",
    "build:linux": "tauri build --bundles deb,rpm,appimage",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "aelux-components": "file:../Aelux-Components",
    "aelux-launcher-lib": "file:../Aelux-Launcher-Lib",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
